{
  "name": "browser-translate",
  "description": "Open-source LLM-powered translation extension (bring your own key).",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-preact": "^1.66.0",
    "preact": "^10.29.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "^3.2.6",
    "@types/chrome": "^0.1.43",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
