# Editor / OS
# `.vscode/` excluded as a whole would make the negation below dead code —
# Git cannot re-include a file whose parent directory is excluded, so exclude
# the contents instead and un-ignore the shared extensions list.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Browser-automation artifacts
.playwright-mcp/

# Local-only docs and agent context
docs/
